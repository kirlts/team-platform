# team-platform variables. `scripts/install.sh` copies this file to .env and fills in the minimum.
# No values: no credential enters the repository (MASTER-SPEC §4.6). An empty variable counts as
# undefined and its default value applies, which appears in the comment. Lines starting with «#» are optional; the value
# of each knob and its source are declared in src/config.js.

# ---- Installation (install.sh fills them in)
# Port on the host, published only on 127.0.0.1 (compose.yml). Empty uses 3000.
PUBLISH_PORT=
# Email of the first Editor. It is created only if the database has no members. Without ADMIN_PASSWORD a
# password is generated and shown only once in the startup log.
ADMIN_EMAIL=
# ADMIN_PASSWORD=

# ---- Model providers (UD-001). The keys live here and never in the database.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=
# ANALYZER=                api | harness (default: api)
# TEXT_PROVIDER=           anthropic | deepseek | groq | openrouter | gemini | openai-compatible (default: anthropic)
# TEXT_MODEL=
# TEXT_BASE_URL=
# TEXT_STRUCTURED=         json_schema | tool | json_object (OpenAI-compatible only)
# TEXT_API_KEY=
# TEXT_FALLBACK_PROVIDER=  fallback provider; without it there is no fallback
# TEXT_FALLBACK_MODEL=
# TEXT_FALLBACK_BASE_URL=
# TEXT_FALLBACK_API_KEY=
# VISION_PROVIDER=         whatever is missing is inherited from TEXT_*
# VISION_MODEL=
# VISION_BASE_URL=
# VISION_API_KEY=
# SPEECH_PROVIDER=         groq-speech (default)
# SPEECH_MODEL=            whisper-large-v3-turbo (default)
# SPEECH_BASE_URL=
# SPEECH_API_KEY=
# ANTHROPIC_CACHE_TTL=     5m | 1h
# ANTHROPIC_THINKING=      disabled
# PROVIDER_TIMEOUT_MS=

# ---- Telemetry (UD-014): spans are stored in SQLite; without an endpoint no connection goes out
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SDK_DISABLED=
# TELEMETRY_INLINE_BLOBS=
# TELEMETRY_FLUSH_MS=
# TELEMETRY_SLICE_ROWS=
# TELEMETRY_QUEUE_MAX_BYTES=
# TELEMETRY_QUEUE_HARD_BYTES=

# ---- Server and data
# HOST=                    0.0.0.0
# PORT=                    3000
# NODE_ENV=                development enables POST /api/auth/dev-login (no password); never in production
# PROJECT_NAME=            name the panel shows (default: Team)
# PROJECT_DESCRIPTION_MAX_CHARS=  cap on the project description, in characters (default: 200000)
# API_PREFIX=              /api
# PUBLIC_URL=              public address; the sso-redirect mode requires it
# LOG_LEVEL=               info
# DATA_DIR=                /data: database, attachments and a copy of the edited templates
# DB_PATH=                 $DATA_DIR/team.db
# PANEL_DIR=               panel/dist
# TEMPLATES_DIR=           templates (the initial set of areas and templates)
# TRUSTED_PROXIES=         list of IPs or CIDRs of the trusted proxies (default: 127.0.0.0/8,::1/128)
# FRAME_ANCESTORS=         'none'; widened only if the application lives in an iframe
# ASSETS_MAX_AGE_SECONDS=
# SQLITE_BUSY_TIMEOUT_MS=
# SQLITE_SYNCHRONOUS=      FULL | NORMAL
# ANALYZE_MODULE=
# EXTRACT_MODULE=
# PROVIDERS_MODULE=
# SKIP_DB_INIT=            1 with the worker in a separate process: the database is initialized beforehand with `npm run db:init`

# ---- A frontend on another origin (MASTER-SPEC §4.11)
# Empty = same origin, no CORS. Origins with no path or trailing slash, separated by commas.
# CORS_ORIGINS=
# same-origin: __Host- cookie with SameSite=Lax. cross-origin: SameSite=None; Secure, and requires CORS_ORIGINS.
# COOKIE_MODE=
# Development over http only: removes Secure and the __Host- prefix. Cannot be combined with cross-origin.
# COOKIE_INSECURE_DEV=

# ---- Job queue (MASTER-SPEC §7.3, report 03)
# WORKER_MODE=             inline | external | off (default: inline)
# QUEUE_LEASE_MS=          30000
# QUEUE_HEARTBEAT_MS=      10000
# QUEUE_MAX_ATTEMPTS=      3
# QUEUE_RETRY_BASE_MS=     1000
# QUEUE_RETRY_MAX_MS=      60000
# QUEUE_RETRY_JITTER=      1
# QUEUE_CONCURRENCY=       3 (measured: `docs/investigaciones/mediciones/2026-10-21-concurrencia-de-la-cola.md`)
# QUEUE_MAX_RUNTIME_MS=    900000
# RETENTION_DAYS=          7
# RETENTION_SWEEP_MS=
# DATA_VERSION_POLL_MS=    100 (only with a separate worker)
# SSE_HEARTBEAT_MS=        15000

# ---- Uploads and lists
# UPLOAD_MAX_IMAGE_BYTES=
# UPLOAD_MAX_AUDIO_BYTES=
# UPLOAD_MAX_DOCUMENT_BYTES=
# UPLOAD_MAX_VIDEO_BYTES=
# UPLOAD_MAX_FILES=
# UPLOAD_MAX_LINKS=
# UPLOAD_MAX_LINK_LENGTH=
# UPLOAD_MAX_TEXT_BYTES=
# LIST_PAGE_SIZE=          50 (the per-page cap is 100)

# ---- Context of the analysis: other unpublished inputs from the same person (UD-025)
# RECENT_INPUTS_MAX=            8
# RECENT_INPUTS_MAX_AGE_MINUTES= 60
# RECENT_INPUTS_EXCERPT_CHARS=  600

# ---- Identidad (MASTER-SPEC §7.7, informe 04)
# IDENTITY_PROVIDER=       local | delegated (default: local)
# ARGON2_MEMORY_KIB=       19456
# ARGON2_PASSES=           2
# ARGON2_PARALLELISM=      1
# ARGON2_SALT_BYTES=       16
# ARGON2_TAG_BYTES=        32
# ARGON2_PEPPER=
# PASSWORD_MIN_LENGTH=     15
# PASSWORD_MAX_LENGTH=     128
# PASSWORD_BLOCKLIST_FILE= file with one disallowed password per line; if undefined, $DATA_DIR/password-blocklist.txt if it exists (downloaded by scripts/install.sh)
# SESSION_TOKEN_BYTES=     32
# SESSION_IDLE_MINUTES=    30
# SESSION_ABSOLUTE_HOURS=  8
# SESSION_TOUCH_SECONDS=
# LOGIN_IP_LIMIT=          3
# LOGIN_IP_WINDOW_MS=      10000
# LOGIN_BACKOFF_BASE_SECONDS=
# LOGIN_BACKOFF_MAX_SECONDS=
# LOGIN_HARD_CAP=          100

# ---- Delegated identity (IDENTITY_PROVIDER=delegated)
# DELEGATED_MODE=          signed-header | jwt | sso-redirect | trusted-header
# DELEGATED_SECRETS=       one or two secrets (rotation)
# DELEGATED_TS_TOLERANCE_SECONDS=
# DELEGATED_BIND_REQUEST=  the signature covers method and path (default: true)
# JWT_HEADER=
# JWT_JWKS_URL=
# JWT_JWKS_COOLDOWN_MS=
# JWT_SECRET=
# JWT_ALGORITHMS=
# JWT_ISSUER=
# JWT_AUDIENCE=
# JWT_EMAIL_CLAIM=
# SSO_LOGIN_URL=
# SSO_SECRET=
# SSO_NONCE_MINUTES=
# TRUSTED_HEADER_NAME=
