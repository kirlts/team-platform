# Variables de team-platform. `scripts/install.sh` copia este archivo a .env y completa lo mínimo.
# Sin valores: ninguna credencial entra al repositorio (MASTER-SPEC §4.6). Una variable vacía cuenta como no
# definida y rige su valor por omisión, que figura en el comentario. Las líneas con «#» son opcionales; el valor
# de cada perilla y su fuente están declarados en src/config.js.

# ---- Instalación (las completa install.sh)
# Puerto en el anfitrión, publicado sólo en 127.0.0.1 (compose.yml). Vacío usa 3000.
PUBLISH_PORT=
# Correo del primer Editor. Se crea sólo si la base no tiene miembros. Sin ADMIN_PASSWORD se genera una
# contraseña y se muestra una sola vez en el registro de arranque.
ADMIN_EMAIL=
# ADMIN_PASSWORD=

# ---- Proveedores de modelo (UD-001). Las llaves viven acá y nunca en la base.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=
# ANALYZER=                api | harness (omisión: api)
# TEXT_PROVIDER=           anthropic | deepseek | groq | openrouter | gemini | openai-compatible (omisión: anthropic)
# TEXT_MODEL=
# TEXT_BASE_URL=
# TEXT_STRUCTURED=         json_schema | tool | json_object (sólo compatibles con OpenAI)
# TEXT_API_KEY=
# TEXT_FALLBACK_PROVIDER=  proveedor de respaldo; sin él no hay respaldo
# TEXT_FALLBACK_MODEL=
# TEXT_FALLBACK_BASE_URL=
# TEXT_FALLBACK_API_KEY=
# VISION_PROVIDER=         lo que falte se hereda de TEXT_*
# VISION_MODEL=
# VISION_BASE_URL=
# VISION_API_KEY=
# SPEECH_PROVIDER=         groq-speech (omisión)
# SPEECH_MODEL=            whisper-large-v3-turbo (omisión)
# SPEECH_BASE_URL=
# SPEECH_API_KEY=
# ANTHROPIC_CACHE_TTL=     5m | 1h
# ANTHROPIC_THINKING=      disabled
# PROVIDER_TIMEOUT_MS=

# ---- Telemetría (UD-014): los spans se guardan en SQLite; sin endpoint no sale ninguna conexión
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SDK_DISABLED=
# TELEMETRY_INLINE_BLOBS=
# TELEMETRY_FLUSH_MS=
# TELEMETRY_SLICE_ROWS=
# TELEMETRY_QUEUE_MAX_BYTES=
# TELEMETRY_QUEUE_HARD_BYTES=

# ---- Servidor y datos
# HOST=                    0.0.0.0
# PORT=                    3000
# NODE_ENV=                development habilita POST /api/auth/dev-login (sin contraseña); nunca en producción
# PROJECT_NAME=            nombre que muestra el panel (omisión: Team)
# API_PREFIX=              /api
# PUBLIC_URL=              dirección pública; la exige el modo sso-redirect
# LOG_LEVEL=               info
# DATA_DIR=                /data: base, adjuntos y copia de las plantillas editadas
# DB_PATH=                 $DATA_DIR/team.db
# PANEL_DIR=               panel/dist
# TEMPLATES_DIR=           templates (el juego inicial de áreas y plantillas)
# TRUSTED_PROXIES=         lista de IP o CIDR de los proxies de confianza (omisión: 127.0.0.0/8,::1/128)
# FRAME_ANCESTORS=         'none'; se amplía sólo si la aplicación vive en un iframe
# ASSETS_MAX_AGE_SECONDS=
# SQLITE_BUSY_TIMEOUT_MS=
# SQLITE_SYNCHRONOUS=      FULL | NORMAL
# ANALYZE_MODULE=
# EXTRACT_MODULE=
# PROVIDERS_MODULE=
# SKIP_DB_INIT=            1 con el worker en proceso aparte: la base se inicializa antes con `npm run db:init`

# ---- Un frontend en otro origen (MASTER-SPEC §4.11)
# Vacía = mismo origen, sin CORS. Orígenes sin ruta ni barra final, separados por comas.
# CORS_ORIGINS=
# same-origin: cookie __Host- con SameSite=Lax. cross-origin: SameSite=None; Secure, y exige CORS_ORIGINS.
# COOKIE_MODE=
# Sólo desarrollo por http: quita Secure y el prefijo __Host-. No se combina con cross-origin.
# COOKIE_INSECURE_DEV=

# ---- Cola de trabajos (MASTER-SPEC §7.3, informe 03)
# WORKER_MODE=             inline | external | off (omisión: inline)
# QUEUE_LEASE_MS=          30000
# QUEUE_HEARTBEAT_MS=      10000
# QUEUE_MAX_ATTEMPTS=      3
# QUEUE_RETRY_BASE_MS=     1000
# QUEUE_RETRY_MAX_MS=      60000
# QUEUE_RETRY_JITTER=      1
# QUEUE_CONCURRENCY=       1
# QUEUE_MAX_RUNTIME_MS=    900000
# RETENTION_DAYS=          7
# RETENTION_SWEEP_MS=
# DATA_VERSION_POLL_MS=    100 (sólo con worker aparte)
# SSE_HEARTBEAT_MS=        15000

# ---- Subidas y listas
# UPLOAD_MAX_IMAGE_BYTES=
# UPLOAD_MAX_AUDIO_BYTES=
# UPLOAD_MAX_DOCUMENT_BYTES=
# UPLOAD_MAX_VIDEO_BYTES=
# UPLOAD_MAX_FILES=
# UPLOAD_MAX_LINKS=
# UPLOAD_MAX_LINK_LENGTH=
# UPLOAD_MAX_TEXT_BYTES=
# LIST_PAGE_SIZE=          50 (el tope por página es 100)

# ---- Identidad (MASTER-SPEC §7.7, informe 04)
# IDENTITY_PROVIDER=       local | delegated (omisión: local)
# ARGON2_MEMORY_KIB=       19456
# ARGON2_PASSES=           2
# ARGON2_PARALLELISM=      1
# ARGON2_SALT_BYTES=       16
# ARGON2_TAG_BYTES=        32
# ARGON2_PEPPER=
# PASSWORD_MIN_LENGTH=     15
# PASSWORD_MAX_LENGTH=     128
# PASSWORD_BLOCKLIST_FILE= archivo con una contraseña no permitida por línea; sin definir, $DATA_DIR/password-blocklist.txt si existe (lo baja scripts/install.sh)
# SESSION_TOKEN_BYTES=     32
# SESSION_IDLE_MINUTES=    30
# SESSION_ABSOLUTE_HOURS=  8
# SESSION_TOUCH_SECONDS=
# LOGIN_IP_LIMIT=          3
# LOGIN_IP_WINDOW_MS=      10000
# LOGIN_BACKOFF_BASE_SECONDS=
# LOGIN_BACKOFF_MAX_SECONDS=
# LOGIN_HARD_CAP=          100

# ---- Identidad delegada (IDENTITY_PROVIDER=delegated)
# DELEGATED_MODE=          signed-header | jwt | sso-redirect | trusted-header
# DELEGATED_SECRETS=       uno o dos secretos (rotación)
# DELEGATED_TS_TOLERANCE_SECONDS=
# DELEGATED_BIND_REQUEST=  la firma cubre método y ruta (omisión: true)
# JWT_HEADER=
# JWT_JWKS_URL=
# JWT_JWKS_COOLDOWN_MS=
# JWT_SECRET=
# JWT_ALGORITHMS=
# JWT_ISSUER=
# JWT_AUDIENCE=
# JWT_EMAIL_CLAIM=
# SSO_LOGIN_URL=
# SSO_SECRET=
# SSO_NONCE_MINUTES=
# TRUSTED_HEADER_NAME=
