    "src/worker.js": ["src/worker.test.js", "src/worker-process.test.js", "src/execute/*.test.js", "e2e/contrato/C*.e2e.test.mjs"],
    "src/db/": ["src/db/*.test.js", "src/execute/deliver.test.js", "src/telemetry/*.test.js"],
    "src/domain/": ["src/domain/*.test.js", "src/api/*.test.js"],
    "src/api/": ["src/api/*.test.js"],
    "src/config.js": ["src/api/mount.test.js", "src/execute/*.test.js", "src/domain/*.test.js"],
    "src/events/": ["src/events/*.test.js", "src/api/*.test.js"],
    "scripts/": ["scripts/*.test.mjs"],
    "e2e/": ["e2e/contrato/C*.e2e.test.mjs"],
    "drivers/": ["src/execute/drivers-docker-local.test.js", "scripts/host-conformance.test.mjs"],
