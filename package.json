{
  "name": "team-platform",
  "version": "0.1.0",
  "description": "Bandeja de entrada para equipos pequeños: un input se descompone en mensajes categorizados y asignados.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "db:init": "node src/db/init.js",
    "seed": "node src/db/seed.js",
    "test": "node scripts/test-dirigido.mjs",
    "test:bench": "node --test bench/",
    "test:rapido": "node scripts/test-quick.mjs",
    "gen:client": "npm run gen:client --prefix packages/client",
    "test:client": "npm test --prefix packages/client",
    "test:sigkill": "node --test src/execute/machines-sigkill.docker.test.js",
    "test:image": "docker build -t team-platform:test . && TEAM_PLATFORM_IMAGE=team-platform:test node --test src/image.docker.test.js src/image-walkthrough.docker.test.js",
    "test:completa": "node --test \"src/**/*.test.js\" \"scripts/*.test.mjs\"",
    "test:panel": "cd panel && npx tsc --noEmit && npx vitest run",
    "e2e:contrato:claude": "node --test --test-concurrency=6 \"e2e/contrato/C*.e2e.test.mjs\"",
    "posttest:completa": "node scripts/test-quick.mjs --mark",
    "e2e:contrato": "node --test-reporter=spec e2e/contrato/run.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/sse": "0.6.1",
    "@fastify/static": "10.1.6",
    "@fastify/swagger": "9.9.2",
    "@hyzyla/pdfium": "3.0.0",
    "@mozilla/readability": "0.6.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "ajv": "^8.20.0",
    "fastify": "5.12.7",
    "jose": "6.2.13",
    "js-yaml": "^5.5.0",
    "linkedom": "0.18.13",
    "officeparser": "8.2.0",
    "pdf-lib": "1.17.1",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "turndown": "7.2.4",
    "undici": "8.12.3"
  },
  "devDependencies": {
    "@readme/openapi-parser": "9.1.0",
    "docx": "9.13.0",
    "fast-check": "4.10.2",
    "fflate": "0.8.3"
  }
}
