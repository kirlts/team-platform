# team-platform variables. `scripts/install.sh` copies this file to .env and fills in the minimum.
# No values: no credential enters the repository (MASTER-SPEC §4.6). An empty variable counts as
# undefined and its default value applies, which appears in the comment. Lines starting with «#» are optional; the value
# of each knob and its source are declared in src/config.js.

# ---- Installation (install.sh fills them in)
# Port on the host, published only on 127.0.0.1 (compose.yml). Empty uses 3000.
PUBLISH_PORT=
# Name of the image in the host's Docker. Empty uses team-platform:local. A second instance in another directory sets its own.
IMAGE_TAG=
# Email of the first Editor. It is created only if the database has no members. Without ADMIN_PASSWORD a
# password is generated and shown only once in the startup log.
ADMIN_EMAIL=
# ADMIN_PASSWORD=

# ---- Model providers (UD-001). The keys live here and never in the database.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=
# ANALYZER=                api | harness (default: api)
# CLAUDE_CODE_OAUTH_TOKEN=   subscription token for ANALYZER=harness (claude setup-token); never in the image (docs/INSTALACION.md)
# TEXT_PROVIDER=           anthropic | deepseek | groq | openrouter | gemini | openai-compatible (default: anthropic)
# TEXT_MODEL=
# TEXT_BASE_URL=
# TEXT_STRUCTURED=         json_schema | tool | json_object (OpenAI-compatible only)
# TEXT_API_KEY=
# TEXT_FALLBACK_PROVIDER=  fallback provider; without it there is no fallback
# TEXT_FALLBACK_MODEL=
# TEXT_FALLBACK_BASE_URL=
# TEXT_FALLBACK_API_KEY=
# VISION_PROVIDER=         whatever is missing is inherited from TEXT_*
# VISION_MODEL=
# VISION_BASE_URL=
# VISION_API_KEY=
# SPEECH_PROVIDER=         groq-speech (default)
# SPEECH_MODEL=            whisper-large-v3-turbo (default)
# SPEECH_BASE_URL=
# SPEECH_API_KEY=
# ANTHROPIC_CACHE_TTL=     5m | 1h
# ANTHROPIC_CACHE_WARMUP=  off = parallel calls with the same prefix all leave at once (default: the first streams and the others wait for its first event, then read the cache)
# ANTHROPIC_THINKING=      disabled
# PROVIDER_TIMEOUT_MS=
# PROVIDER_MAX_INFLIGHT_ANTHROPIC=          7: simultaneous requests to Anthropic in the whole process; 0 = no cap (measured: `docs/investigaciones/mediciones/2026-10-21-concurrencia-de-la-cola.md`)
# PROVIDER_MAX_INFLIGHT_GROQ=               same for Groq (text and transcription)
# PROVIDER_MAX_INFLIGHT_OPENAI_COMPATIBLE=  same for the other OpenAI-compatible providers
# PROVIDER_BACKOFF_COOLDOWN_MS=             wait after a cap 429 before giving requests back to the cap
# PROVIDER_BACKOFF_RESTORE_STEP_MS=         time per request given back to the cap
# PROVIDER_PROBE_TIMEOUT_MS=                deadline of each request of a probe from Configuración (30000 by default)
# SECRETS_KEY=                              master key of the API keys stored from Configuración: 64 hex characters or 44 in base64 (32 random bytes). Without it a key file is created in DATA_DIR at the first start

# ---- Telemetry (UD-014): spans are stored in SQLite; without an endpoint no connection goes out
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SDK_DISABLED=
# TELEMETRY_INLINE_BLOBS=
# TELEMETRY_FLUSH_MS=
# TELEMETRY_SLICE_ROWS=
# TELEMETRY_QUEUE_MAX_BYTES=
# TELEMETRY_QUEUE_HARD_BYTES=
# UI_TELEMETRY=            interface telemetry on or off at the start (default: on; the Editor changes it in Configuración)
# UI_TELEMETRY_MAX_BODY_BYTES=
# UI_TELEMETRY_MAX_EVENTS=
# UI_TELEMETRY_RATE_MAX=
# UI_TELEMETRY_RATE_WINDOW_MS=

# ---- Server and data
# HOST=                    0.0.0.0
# PORT=                    3000
# NODE_ENV=                development enables POST /api/auth/dev-login (no password); never in production
# PROJECT_NAME=            name the panel shows (default: Team)
# PROJECT_DESCRIPTION_MAX_CHARS=  cap on the project description, in characters (default: 200000)
# PROJECT_NAME_MAX_CHARS=  cap on the project name written in Configuración, in characters (default: 80)
# ANALYSIS_FRAMING_MAX_CHARS=  cap on each framing of the analysis, in characters (default: 2000)
# API_PREFIX=              /api
# PUBLIC_URL=              public address; the sso-redirect mode requires it
# LOG_LEVEL=               info
# DATA_DIR=                /data: database, attachments and a copy of the edited templates
# DB_PATH=                 $DATA_DIR/team.db
# EXAMPLES_DIR=            <repository>/ejemplos: the sample set that «Sembrar ejemplos» loads (POST /ops/seed)
# PANEL_DIR=               panel/dist
# TEMPLATES_DIR=           templates (the initial set of areas and templates)
# TRUSTED_PROXIES=         list of IPs or CIDRs of the trusted proxies (default: 127.0.0.0/8,::1/128)
# FRAME_ANCESTORS=         'none'; widened only if the application lives in an iframe
# BASE_PATH=               / ; path where the panel and its assets are served, e.g. /team/ (docs/INSTALACION.md)
# CSP_CONNECT_SRC=         extra connect-src sources besides 'self', separated by commas
# SSO_RETURN_PATH=         / ; where the sso-redirect return lands after the session is set
# THEME_CSS=               .css file on the server's disk, served as <BASE_PATH>theme.css after the panel stylesheet
# ASSETS_MAX_AGE_SECONDS=
# COMPRESSION_MIN_BYTES=   1460 ; size under which an answer is not compressed (0 compresses all); the panel files are precompressed at build
# SQLITE_BUSY_TIMEOUT_MS=
# SQLITE_SYNCHRONOUS=      FULL | NORMAL
# ANALYZE_MODULE=
# EXTRACT_MODULE=
# PROVIDERS_MODULE=
# SKIP_DB_INIT=            1 with the worker in a separate process: the database is initialized beforehand with `npm run db:init`

# ---- A frontend on another origin (MASTER-SPEC §4.11)
# Empty = same origin, no CORS. Origins with no path or trailing slash, separated by commas.
# CORS_ORIGINS=
# same-origin: __Host- cookie with SameSite=Lax. cross-origin: SameSite=None; Secure, and requires CORS_ORIGINS.
# COOKIE_MODE=
# Development over http only: removes Secure and the __Host- prefix. Cannot be combined with cross-origin.
# COOKIE_INSECURE_DEV=

# ---- Job queue (MASTER-SPEC §7.3, report 03)
# WORKER_MODE=             inline | external | off (default: inline)
# QUEUE_LEASE_MS=          30000
# QUEUE_HEARTBEAT_MS=      10000
# QUEUE_MAX_ATTEMPTS=      3
# QUEUE_RETRY_BASE_MS=     1000
# QUEUE_RETRY_MAX_MS=      60000
# QUEUE_RETRY_JITTER=      1
# QUEUE_CONCURRENCY=       8 (measured, with the PROVIDER_MAX_INFLIGHT_* cap: `docs/investigaciones/mediciones/2026-10-21-concurrencia-de-la-cola.md`)
# QUEUE_MAX_RUNTIME_MS=    900000
# QUEUE_ABORT_GRACE_MS=    5000
# RETENTION_DAYS=          7
# RETENTION_SWEEP_MS=
# DATA_VERSION_POLL_MS=    100 (only with a separate worker)
# SSE_HEARTBEAT_MS=        15000

# ---- Unattended Claude Code session for agent members (UD-254, UD-255; docs/INSTALACION.md «El trabajador que ejecuta»)
# EXECUTE_RUNNER=          local | machine (default: local)
# EXECUTE_CLAUDE_BIN=      claude executable of the local runner (default: claude)
# EXECUTE_MACHINE_CLAUDE_BIN=  claude executable inside the machine (default: claude)
# EXECUTE_REPO_DIR=        host repository; each job works on a worktree of it, branch tp/<message_id>
# EXECUTE_WORK_ROOT=       where each job directory is created (default: $DATA_DIR/tmp)
# EXECUTE_TEAM_URL=        API address the session calls with `team` (default: http://127.0.0.1:$PORT)
# EXECUTE_MODEL=           claude-sonnet-5-5
# EXECUTE_EFFORT=          low | medium | high | xhigh | max (default: medium)
# EXECUTE_MAX_BUDGET_USD=  10
# EXECUTE_SESSION_RESERVE_USD=  (optional: what each session holds back of the day; when set it rules over the measurement, UD-305)
# EXECUTE_SESSION_RESERVE_FALLBACK_USD=  10
# EXECUTE_DAILY_BUDGET_USD=   10; total of all execute jobs per server-local day (TZ; UTC when unset)
# EXECUTE_CAPACITY_WAIT_MS=    30000; wait before a job looks again for a free machine
# EXECUTE_MACHINE_COST_USD=   0; fixed cost added for each job run with EXECUTE_RUNNER=machine
# EXECUTE_MAX_TURNS=       60
# EXECUTE_MAX_SUBAGENTS=   3
# EXECUTE_CAPTURES_MAX=    3; screenshots of the interface per reply (the size cap is UPLOAD_MAX_IMAGE_BYTES)
# EXECUTE_CAPTURES_OPEN_ZONE= the value of the output's `zone` that means no sensitive data (default: `ninguna`); only with it is a capture that is not masked attached
# EXECUTE_CAPTURES_UNMASKED= denied (default: a capture that is not masked needs the open zone) | allowed or 1: it is attached whatever the zone, the host accepts screenshots with personal data
# EXECUTE_AUTO_CLOSE=      on (default: Claude may close the message after its final reply when the delivery ended in green or nothing needed to change, nothing is left to the sender and nobody replied meanwhile) | off or 0: it never closes
# EXECUTE_SCREEN_PATHS=    empty (default: the system decides nothing on its own) | comma-separated path prefixes of the host's interface, e.g. panel/src/,design-system/src/: a delivery whose `##team changed <path>` lines touch one of them counts as touching a screen, and without a capture it asks for one in a second pass before closing
# EXECUTE_CONTRACT_VERSION= the version of the host contract the driver meets (docs/CONTRATO-DE-ANFITRION.md), e.g. 1; the worker does not start if its major differs from the core's; empty = not declared, not checked
# EXECUTE_HOST_INSTRUCTIONS= path to a host .md file with the host's rules; appended to every execute prompt
# EXECUTE_MAX_ATTEMPTS=    1
# EXECUTE_TIMEOUT_MS=      3600000
# EXECUTE_KILL_GRACE_MS=   10000
# EXECUTE_OTEL_ENV=        KEY=VALUE pairs separated by spaces, passed as is to `claude -p` for its own telemetry (CLAUDE_CODE_ENABLE_TELEMETRY, OTEL_*); empty = none. The session always receives TRACEPARENT
# EXECUTE_SESSION_ENV=     KEY=VALUE pairs separated by spaces for any other variable of `claude -p`. For the cache: CLAUDE_CODE_PROMPT_CACHE_TTL=1h (v2.1.242 or later) keeps the prefix an hour; sessions that wait more than 5 minutes for a tool rewrite their whole context otherwise
# EXECUTE_LIGHT_MODEL=     claude-haiku-5-5: the model of an area that has not chosen its light one (UD-295); a message whose estimates stay within the limits runs with it
# EXECUTE_LIGHT_LIMITS=    create=1 irreversibility=1 certainty=0: the estimates of the analyzer (0 to 1) beyond which the area's larger model takes the message; derived from bench/model-limits.mjs
# EXECUTE_DIRECT_HOST_INSTRUCTIONS= path of the host's minimal rules for a session on the light model; empty = the same as EXECUTE_HOST_INSTRUCTIONS
# EXECUTE_DIRECT_SESSION_ENV= KEY=VALUE pairs for the environment of a session on the light model; none by default
# EXECUTE_DIRECT_STOP_COMMAND= command of the Stop hook of a session on the light model: the checks that must pass before it finishes (exit 2 sends it back to work)
# EXECUTE_GUARDS_FILE= path of a JSON file with the host's lists for the hooks of every session: Bash commands to refuse, tools to take away, what must hold when the session ends; empty = no hooks (docs/CONTRATO-DE-ANFITRION.md, «Guardias de la sesión»)
# EXECUTE_DIRECT_TOOLS=    Bash,Read,Edit,Write,Grep,Glob,Agent: the tools of a session on the light model (`claude --tools`); empty = all
# EXECUTE_STABLE_AS_SYSTEM= 1 sends the part of the prompt that is the same for every job as --append-system-prompt-file (cached across sessions) and the rest as the user message (default: 0)
# EXECUTE_KEEP_SESSION_ON_SHUTDOWN= 1 keeps the machine and its session when the worker shuts down in an orderly way during RUN, for the next attempt to re-attach (the host's RUN must re-attach); 0 destroys the machine (default: 1)
# EXECUTE_MACHINE_CREATE=  shell command that creates the machine; {job_id} {workdir}; its last stdout line is {machine}
# EXECUTE_MACHINE_RUN=     shell command that runs {workdir}/run.sh on {machine} and streams its stdout
# EXECUTE_MACHINE_DESTROY= shell command that destroys {machine}; runs always, also on failure or timeout
# EXECUTE_MACHINE_COLLECT= optional shell command that copies the session transcript out of {machine} for {job_id} before it is destroyed; its last stdout line (a path or an object key) is stored in `execute_runs.transcript_ref`. Empty = no copy
# EXECUTE_RUNS_RETENTION_DAYS=365   days the history of runs (`execute_runs`, `scripts/tiempos.mjs`) is kept; the spans keep RETENTION_DAYS
# EXECUTE_DELIVER_COMMAND=  shell command that delivers branch {branch} of message {message_id} to production, run by the worker after `execute` with no AI; also {job_id} {workdir}; env TEAM_OUTPUT_JSON = structured output of the session without `summary`. Exit 0 = in production (last stdout line = reference), 75 = not now (waits, no attempt spent), 76 = held for a person's review (last stdout line = reason; no retry), other = failed (its output is the reason). Empty = no separate delivery: `execute` posts its final reply
# EXECUTE_DELIVER_TIMEOUT_MS=  900000; time limit of the delivery command
# EXECUTE_DELIVER_CONCURRENCY=  1; deliveries to production at once
# EXECUTE_INFRA_RETRY_WAIT_MS=  30000; wait before the second try of a job that failed by infrastructure (machine not created, 529 of the model service)
# EXECUTE_DELIVER_CHECK_COMMAND=  empty; shell command run before a delivery with {message_id} {job_id} {branch}: exit 0 means the branch is already in production (last stdout line = reference) and the delivery command does not run
# EXECUTE_DELIVER_RETRIES=  no cap; rounds a failed verification may go back to Claude (the daily budget limits them when unset); 0 reports the first failure
# EXECUTE_DELIVER_MAX_ATTEMPTS=  2; attempts of the delivery job (exit 75 spends none)
# INSTANCE_NAME=           label written in each row of `execute_runs`; empty = host of PUBLIC_URL, or «local». `scripts/tiempos.mjs` shows one instance at a time

# ---- Uploads and lists
# UPLOAD_MAX_IMAGE_BYTES=
# UPLOAD_MAX_AUDIO_BYTES=
# UPLOAD_MAX_DOCUMENT_BYTES=
# UPLOAD_MAX_VIDEO_BYTES=
# UPLOAD_MAX_FILES=
# UPLOAD_MAX_LINKS=
# UPLOAD_MAX_LINK_LENGTH=
# UPLOAD_IDLE_TIMEOUT_MS=   120000
# UPLOAD_MAX_TEXT_BYTES=
# LIST_PAGE_SIZE=          50 (the per-page cap is 100)

# ---- Context of the analysis: other unpublished inputs from the same person (UD-025)
# RECENT_INPUTS_MAX=            8
# RECENT_INPUTS_MAX_AGE_MINUTES= 60
# RECENT_INPUTS_EXCERPT_CHARS=  600

# ---- Identidad (MASTER-SPEC §7.7, report 04)
# IDENTITY_PROVIDER=       local | delegated | signed-header | jwt | sso-redirect | trusted-header, or a comma list in order (default: local)
# ARGON2_MEMORY_KIB=       19456
# ARGON2_PASSES=           2
# ARGON2_PARALLELISM=      1
# ARGON2_SALT_BYTES=       16
# ARGON2_TAG_BYTES=        32
# ARGON2_PEPPER=
# PASSWORD_MIN_LENGTH=     15
# PASSWORD_MAX_LENGTH=     128
# PASSWORD_BLOCKLIST_FILE= file with one disallowed password per line; if undefined, $DATA_DIR/password-blocklist.txt if it exists (downloaded by scripts/install.sh)
# SESSION_TOKEN_BYTES=     32
# SESSION_IDLE_MINUTES=    30
# SESSION_ABSOLUTE_HOURS=  8
# SESSION_TOUCH_SECONDS=
# LOGIN_IP_LIMIT=          3
# LOGIN_IP_WINDOW_MS=      10000
# LOGIN_BACKOFF_BASE_SECONDS=
# LOGIN_BACKOFF_MAX_SECONDS=
# LOGIN_HARD_CAP=          100

# ---- Delegated identity (IDENTITY_PROVIDER=delegated)
# DELEGATED_MODE=          signed-header | jwt | sso-redirect | trusted-header
# DELEGATED_SECRETS=       one or two secrets (rotation)
# DELEGATED_TS_TOLERANCE_SECONDS=
# DELEGATED_BIND_REQUEST=  the signature covers method and path (default: true)
# JWT_HEADER=
# JWT_JWKS_URL=
# JWT_JWKS_COOLDOWN_MS=
# JWT_SECRET=
# JWT_ALGORITHMS=
# JWT_ISSUER=
# JWT_AUDIENCE=
# JWT_EMAIL_CLAIM=
# SSO_LOGIN_URL=
# SSO_SECRET=
# SSO_NONCE_MINUTES=
# TRUSTED_HEADER_NAME=
# ---- Identity governed by the host (H-3720). IDENTITY_PROVIDER also takes a list: jwt,signed-header or local,jwt
# IDENTITY_PROVISION=      closed | host (default: closed). host: an unknown email is created on its first entry with the host role
# JWT_ROLE_CLAIM=          claim with the role member | editor (default: role)
# JWT_NAME_CLAIM=          claim with the name (default: name)
# JWT_COOKIE_NAME=         cookie of the host domain that carries the same JWT; empty = header only
# TRUSTED_NAME_HEADER=     name header of trusted-header (default: tailscale-user-name)
# COOKIE_DOMAIN=           Domain of the session cookie shared with the host, e.g. .ejemplo.cl; drops the __Host- prefix
# COOKIE_NAME=             session cookie name with COOKIE_DOMAIN (default: team_session)
# LOGOUT_URL=              the host's own sign-out; POST /api/auth/logout answers it to the panel
# HOST_LOGIN_URL=          the host's sign-in page; with a host identity (jwt, signed-header, trusted-header) a missing or expired session goes there (default: /session/login)
