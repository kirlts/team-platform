#!/bin/sh
# Refuses a commit that contains a credential (MASTER-SPEC section 4.6) or git conflict markers. Enable it once per clone:
#   git config core.hooksPath .githooks
ROOT="$(git rev-parse --show-toplevel)"
node "$ROOT/scripts/check-conflict-markers.mjs" --staged || exit 1
exec node "$ROOT/scripts/check-secrets.mjs" --staged
