#!/bin/sh
# `main` sólo avanza al commit de `desarrollo` que una publicación declara. Todo trabajo se fusiona a `desarrollo`.
# Un empujón a `main` sale únicamente si lleva la marca de ese mismo sha y el sha es `desarrollo` o un ancestro suyo,
# por avance rápido. Borrar `main` o reescribirla no sale nunca. Se activa con `git config core.hooksPath .githooks`.
#
# La marca que se acepta es el sha que se empuja, no un permiso general:
#   RELEASE_PUBLISHES_MAIN=<sha>  la emite scripts/publish-main.sh, la puerta del canónico: corre la batería y la conformidad
#                                 sobre ese sha y recién entonces empuja.
# La marca heredada DEPLOY_PUBLISHES_MAIN se retiró (plan canónico 2026, pieza C5): ningún entorno la exporta y se rechaza.
# Qué la traería de vuelta: que la puerta no pueda correr la batería en la máquina que publica.
#
# Lo mismo lo mide, del lado del servidor, .github/workflows/main-solo-desde-desarrollo.yml, que es un espejo opcional: el
# repositorio es privado en el plan gratuito (la protección de rama devuelve 403 «Upgrade to GitHub Pro») y nada depende de que corra.
CERO=0000000000000000000000000000000000000000
MAIN=""; MAIN_REMOTO=""
while read -r _local local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] && { MAIN="$local_sha"; MAIN_REMOTO="$remote_sha"; }
done
[ -n "$MAIN" ] || exit 0
no() { echo "  «main» no se empuja: $1" >&2; echo "  Todo se fusiona a «desarrollo»; «main» lo publica scripts/publish-main.sh." >&2; exit 1; }
[ "$MAIN" != "$CERO" ] || no "no se borra."
[ "${RELEASE_PUBLISHES_MAIN:-}" = "$MAIN" ] || no "sólo lo empuja la publicación (scripts/publish-main.sh), con la marca de ese sha."
DESTINO="${2:-origin}"
DES=$(git ls-remote "$DESTINO" refs/heads/desarrollo 2>/dev/null | cut -f1)
[ -n "$DES" ] || no "no pude leer «desarrollo» del remoto."
git cat-file -e "$DES^{commit}" 2>/dev/null || git fetch -q "$DESTINO" refs/heads/desarrollo 2>/dev/null
RAIZ=$(git rev-parse --show-toplevel)
if bash "$RAIZ/scripts/main-solo-desde-desarrollo.sh" "$MAIN" "$DES" "$MAIN_REMOTO" >/dev/null 2>&1; then exit 0; fi
no "$MAIN no es «desarrollo» ($DES) ni un ancestro suyo, o reescribe «main»."
