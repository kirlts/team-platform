# Variables de team-platform. install.sh copia este archivo a .env y completa lo mínimo.
# Lista provisional: la fija el núcleo (MASTER-SPEC §7.6). Sin valores: ninguna credencial entra al repositorio.

# Puerto en el anfitrión, publicado sólo en 127.0.0.1 (compose.yml). Vacío usa 3000.
PUBLISH_PORT=

# Correo del primer Editor. Tiene que existir en members (UD-007).
ADMIN_EMAIL=

# Proveedor de texto y visión (UD-001).
ANTHROPIC_API_KEY=

# Proveedor de transcripción (UD-001). Sin esta llave, audio y video no se transcriben.
GROQ_API_KEY=

# Proveedor de respaldo, opcional.
DEEPSEEK_API_KEY=
